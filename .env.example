# ==============================================================================
# TechZephyr CIT Platform Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Layer (Gemini 2.5 Flash / Multimodal Audio / Text)
# Get a key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon Serverless)
# Neon Console: https://console.neon.tech/
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# NOTE: If this variable is omitted or empty, the app runs automatically with
# an in-memory database preloaded with all 4 authorized demo accounts!
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Session Security
# Secret string used to sign HTTP-only auth cookies (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="cit-campus-scheduling-jwt-secret-key-2026-hackathon"

# ------------------------------------------------------------------------------
# 4. Deployment URLs (Optional)
# ------------------------------------------------------------------------------
# Next.js App Base URL (used in email links)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional external Python FastAPI backend URL (if deployed on Render/Railway/CloudRun)
# Default is http://127.0.0.1:8000 (with automated fallback to direct Python execution)
PYTHON_BACKEND_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 5. Email Notification Dispatch (Optional for live SMTP delivery)
# If omitted, emails generated by the Admin Provisioning tool are logged cleanly
# and open via native mailto / copy credentials links.
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@cit.edu.in"
# SMTP_PASS="your-app-password"
# SMTP_FROM='"CIT Dean Office" <no-reply@cit.edu.in>'

